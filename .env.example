# Copy to .env and set only the values you intend to opt in.
# Never commit .env. Never put a real key in this file.
# Blank key lines stay unconfigured. Mission create returns HTTP 503 until one provider is set.
# This file does not enable live payment settlement.
#
# Leave override lines commented. A present-but-empty SWARM_MODEL or
# SWARM_MAX_OUTPUT_TOKENS replaces the built-in default.

# --- Providers (one key is enough) ---
OPENAI_API_KEY=
# SWARM_MODEL=
# SWARM_REASONING_EFFORT=

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=
# OPENROUTER_SITE_URL=
# OPENROUTER_TITLE=

XAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

# Azure OpenAI opts in only when key, endpoint, and deployment are all set.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

PERPLEXITY_API_KEY=
# Bedrock opts in from this key or AWS_BEARER_TOKEN_BEDROCK. Ambient IAM keys do not.
BEDROCK_API_KEY=
HUGGINGFACE_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
# Vertex opts in only when VERTEX_API_KEY and VERTEX_PROJECT (or GOOGLE_CLOUD_PROJECT) are set.
VERTEX_API_KEY=
VERTEX_PROJECT=

# Local OpenAI-compatible daemons. Setting either variable opts that adapter in.
# A down daemon is reported unavailable and does not invent a completion.
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# VLLM_BASE_URL=
# VLLM_MODEL=
# LLAMACPP_BASE_URL=
# LLAMACPP_MODEL=

# --- Optional tools (unset or blank = off) ---
# Comma-separated allowlist: echo,clock.utc,hash.sha256
SWARM_LOCAL_TOOLS=
# 1/true/yes/on. Also requires the browser extra and playwright install chromium.
SWARM_BROWSER=
MCP_SERVER_URL=
MCP_API_KEY=
COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=
# COMPOSIO_TOOLKITS=
# COMPOSIO_BASE_URL=

# Self-mod: propose/diff only until the write flags are also set.
# Production writes still refuse protected core paths.
SWARM_SELFMOD=
SWARM_SELFMOD_WRITE=
SWARM_SELFMOD_PRODUCTION_WRITE=
# SWARM_SELFMOD_SANDBOX=

# --- Process and evidence (commented so defaults stay in force) ---
# SWARM_DATABASE_PATH=
# SWARM_WORKSPACE_ROOT=
# SWARM_PROCESS_WORKERS=
# SWARM_EVIDENCE=
# SWARM_EVIDENCE_HTTP_HOSTS=
# SWARM_EVIDENCE_ROOT=
# SWARM_DEFAULT_TOKEN_BUDGET=
# SWARM_TOKEN_BUDGET_HARD_CAP=
# SWARM_TOKEN_UNKNOWN_PRICE=
